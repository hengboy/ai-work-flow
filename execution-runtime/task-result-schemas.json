    "finding_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "prompt_type": "string[]" },
    "fixed_finding_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "prompt_type": "string[]" },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$", "prompt_type": "git sha" },
    "implementation_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "prompt_type": "string[]" },
    "implementation_kind": { "type": "string", "enum": ["bug", "small_feature"], "prompt_type": "bug|small_feature" },
    "message": { "type": "string", "minLength": 1, "prompt_type": "string" },
