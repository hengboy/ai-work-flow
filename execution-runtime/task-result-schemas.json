    "operation": { "type": "string", "minLength": 1, "prompt_type": "string" },
    "paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "prompt_type": "string[]" },
    "plan_id": { "type": "string", "minLength": 1, "prompt_type": "string" },
    "planning_context": { "$ref": "#/structured_content_schemas/planning_context", "prompt_type": "planning_context object" },
    "report_path": { "type": "string", "minLength": 1, "prompt_type": "path string" },
    "resulting_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$", "prompt_type": "git sha" },
    "review_axis_result": { "$ref": "#/structured_content_schemas/review_axis_result", "prompt_type": "review_axis_result object" },
    "review_packet": { "$ref": "#/structured_content_schemas/review_packet", "prompt_type": "review_packet object" },
