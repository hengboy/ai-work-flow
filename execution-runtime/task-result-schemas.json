  "structured_content_schemas": {
    "planning_context": {
      "type": "object",
      "required": ["plan_id", "task_mode", "goal", "users_consumers", "success_criteria", "scope", "constraints", "assumptions", "acceptance_criteria", "decisions", "open_questions"],
      "properties": {
        "plan_id": { "type": "string", "minLength": 1 },
        "task_mode": { "type": "string", "enum": ["single", "split"] },
        "goal": { "type": "string", "minLength": 1 },
        "users_consumers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "success_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "scope": { "type": "object", "minProperties": 1 },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "acceptance_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "decisions": { "type": "array", "items": { "$ref": "#/structured_content_schemas/decision" } },
        "open_questions": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["code", "revision", "summary"],
      "properties": { "code": { "type": "string", "minLength": 1 }, "revision": { "type": "integer", "minimum": 1 }, "summary": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "change_evidence": {
      "type": "object",
      "required": ["base_sha", "head_sha", "path_changes", "acceptance_evidence", "verification"],
      "properties": {
        "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "path_changes": { "type": "array", "items": { "$ref": "#/structured_content_schemas/path_change" }, "minItems": 1 },
        "acceptance_evidence": { "type": "array", "items": { "$ref": "#/structured_content_schemas/acceptance_evidence" }, "minItems": 1 },
        "verification": { "type": "array", "items": { "$ref": "#/structured_content_schemas/verification" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "path_change": {
      "type": "object",
      "required": ["record_type", "index_status", "worktree_status", "path"],
      "properties": { "record_type": { "type": "string", "enum": ["1", "2", "u", "?", "!"] }, "index_status": { "type": "string", "pattern": "^[.MTADRCU]$" }, "worktree_status": { "type": "string", "pattern": "^[.MTADRCU]$" }, "path": { "type": "string", "minLength": 1 }, "source_path": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "acceptance_evidence": {
      "type": "object",
      "required": ["criterion", "evidence"],
      "properties": { "criterion": { "type": "string", "minLength": 1 }, "evidence": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["command", "result"],
      "properties": { "command": { "type": "string", "minLength": 1 }, "result": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "review_packet": {
      "type": "object",
      "required": ["base_sha", "review_sha", "review_context", "slices"],
      "properties": { "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }, "review_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }, "review_context": { "type": "object", "minProperties": 1 }, "slices": { "type": "array", "items": { "type": "object" }, "minItems": 1 } },
      "additionalProperties": false
    },
    "review_axis_result": {
      "type": "object",
      "required": ["axis", "findings", "advisory_findings", "coverage"],
      "properties": { "axis": { "type": "string", "enum": ["standards", "spec"] }, "findings": { "type": "array", "items": { "type": "object" } }, "advisory_findings": { "type": "array", "items": { "type": "object" } }, "coverage": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true } },
      "additionalProperties": false
    },
    "review_result": {
      "type": "object",
      "required": ["axis_results", "verdict", "finding_ids", "coverage"],
      "properties": { "axis_results": { "type": "array", "items": { "$ref": "#/structured_content_schemas/review_axis_result" }, "minItems": 2, "maxItems": 2 }, "verdict": { "type": "string", "enum": ["passed", "blocking"] }, "finding_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "coverage": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true } },
      "additionalProperties": false
    }
  }
}
