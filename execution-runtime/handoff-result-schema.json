{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Work Flow Handoff Result",
  "type": "object",
  "required": ["role_id", "session_id", "claim_id", "status", "summary", "artifacts", "checks", "payload"],
  "additionalProperties": false,
  "properties": {
    "role_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "claim_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["done", "blocked"] },
    "summary": { "type": "string", "minLength": 1 },
    "artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "error": { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "required": ["ticket_id", "status", "commits", "checks", "summary", "changed_paths"],
      "additionalProperties": false,
      "properties": {
        "ticket_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["done", "blocked"] },
        "commits": { "type": "array", "items": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" } },
        "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "changed_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/path-change" }
        },
        "summary": { "type": "string", "minLength": 1 },
        "error": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "done" } }, "required": ["status"] }, "then": { "properties": { "commits": { "type": "array", "minItems": 1 } }, "not": { "required": ["error"], "properties": { "error": true } } } },
        { "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] }, "then": { "required": ["error"], "properties": { "commits": { "type": "array", "maxItems": 0 } } } }
      ]
    }
  },
  "$defs": {
    "path-change": {
      "type": "object",
      "required": ["record_type", "index_status", "worktree_status", "path"],
      "additionalProperties": false,
      "properties": {
        "record_type": { "enum": ["1", "2", "u", "?", "!"] },
        "index_status": { "enum": [".", "M", "T", "A", "D", "R", "C", "U"] },
        "worktree_status": { "enum": [".", "M", "T", "A", "D", "R", "C", "U"] },
        "path": { "type": "string", "minLength": 1, "not": { "pattern": "\\u0000" } },
        "source_path": { "type": "string", "minLength": 1, "not": { "pattern": "\\u0000" } }
      },
      "allOf": [
        { "if": { "properties": { "record_type": { "const": "2" } }, "required": ["record_type"] }, "then": { "required": ["source_path"], "properties": { "source_path": true } } },
        { "if": { "properties": { "record_type": { "not": { "const": "2" } } }, "required": ["record_type"] }, "then": { "not": { "required": ["source_path"] } } }
      ]
    }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "done" } }, "required": ["status"] }, "then": { "not": { "required": ["error"], "properties": { "error": true } } } },
    { "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] }, "then": { "required": ["error"] } }
  ]
}
