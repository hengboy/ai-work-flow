{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengboy/ai-work-flow/schemas/run-matt-spec-to-completion/checkpoint.schema.json",
  "$defs": {
    "shanghai-date-time": { "type": "string", "format": "date-time", "pattern": "\\+08:00$" }
  },
  "title": "run-matt-spec-to-completion Checkpoint",
  "type": "object",
  "required": ["version", "spec", "status", "baseline", "branch", "worktree", "created_at", "updated_at", "tickets", "review", "integration", "history"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "spec": {
      "type": "object",
      "required": ["path", "revision"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^\\.scratch/[a-z0-9][a-z0-9-]*/spec\\.md$" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "status": { "type": "string", "enum": ["executing", "reviewing", "fixing", "integrating", "complete"] },
    "baseline": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "branch": { "type": "string", "minLength": 1 },
    "worktree": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*[\\\\\\u0000-\\u001F\\u007F])(?!\\.\\.?/)(?!.*(?:/\\.\\.?/|/\\.\\.?$)).+$" },
    "created_at": { "$ref": "#/$defs/shanghai-date-time" },
    "updated_at": { "$ref": "#/$defs/shanghai-date-time" },
    "tickets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pending", "in_progress", "done", "blocked"] },
          "start_commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
          "end_commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
          "error": { "type": "string", "minLength": 1 },
          "started_at": { "$ref": "#/$defs/shanghai-date-time" },
          "completed_at": { "$ref": "#/$defs/shanghai-date-time" }
        },
        "allOf": [
          { "if": { "properties": { "status": { "const": "pending" } }, "required": ["status"] }, "then": { "not": { "anyOf": [{ "properties": { "start_commit": true }, "required": ["start_commit"] }, { "properties": { "started_at": true }, "required": ["started_at"] }, { "properties": { "end_commit": true }, "required": ["end_commit"] }, { "properties": { "completed_at": true }, "required": ["completed_at"] }, { "properties": { "error": true }, "required": ["error"] }] } } },
          { "if": { "properties": { "status": { "const": "in_progress" } }, "required": ["status"] }, "then": { "required": ["start_commit", "started_at"], "properties": { "start_commit": true, "started_at": true }, "not": { "anyOf": [{ "properties": { "end_commit": true }, "required": ["end_commit"] }, { "properties": { "completed_at": true }, "required": ["completed_at"] }, { "properties": { "error": true }, "required": ["error"] }] } } },
          { "if": { "properties": { "status": { "const": "done" } }, "required": ["status"] }, "then": { "required": ["start_commit", "started_at", "end_commit", "completed_at"], "properties": { "start_commit": true, "started_at": true, "end_commit": true, "completed_at": true }, "not": { "properties": { "error": true }, "required": ["error"] } } },
          { "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] }, "then": { "required": ["start_commit", "started_at", "error"], "properties": { "start_commit": true, "started_at": true, "error": true }, "not": { "anyOf": [{ "properties": { "end_commit": true }, "required": ["end_commit"] }, { "properties": { "completed_at": true }, "required": ["completed_at"] }] } } }
        ]
      }
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": { "status": { "type": "string", "enum": ["pending", "in_progress", "awaiting_user", "done"] }, "fixed_point": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }, "review_commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }, "fix_commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }, "fix_checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "findings_summary": { "type": "string", "minLength": 1 }, "decision": { "type": "string", "enum": ["approve", "fix"] }, "started_at": { "$ref": "#/$defs/shanghai-date-time" }, "completed_at": { "$ref": "#/$defs/shanghai-date-time" } },
      "allOf": [
        { "if": { "properties": { "status": { "const": "pending" } }, "required": ["status"] }, "then": { "not": { "anyOf": [{ "properties": { "fixed_point": true }, "required": ["fixed_point"] }, { "properties": { "review_commit": true }, "required": ["review_commit"] }] } } },
        { "if": { "properties": { "status": { "enum": ["in_progress", "awaiting_user", "done"] } }, "required": ["status"] }, "then": { "required": ["fixed_point", "review_commit", "started_at"], "properties": { "fixed_point": true, "review_commit": true, "started_at": true } } },
        { "if": { "properties": { "status": { "const": "done" } }, "required": ["status"] }, "then": { "required": ["fixed_point", "review_commit", "findings_summary", "started_at", "completed_at"], "properties": { "fixed_point": true, "review_commit": true, "findings_summary": true, "started_at": true, "completed_at": true } } }
      ]
    },
    "integration": {
      "type": "object",
      "required": ["status", "target_branch"],
      "additionalProperties": false,
      "properties": { "status": { "type": "string", "enum": ["pending", "merged", "done"] }, "target_branch": { "const": "main" }, "execution_head": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }, "main_worktree": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*[\\\\\\u0000-\\u001F\\u007F])(?!\\.\\.?/)(?!.*(?:/\\.\\.?/|/\\.\\.?$)).+$" }, "merged_commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }, "merged_at": { "$ref": "#/$defs/shanghai-date-time" }, "cleaned_up_at": { "$ref": "#/$defs/shanghai-date-time" }, "stash_operation_id": { "type": "string", "minLength": 1 }, "stash_ref": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }, "stash_restore_state": { "type": "string", "enum": ["applying", "restored"] }, "stash_restored": { "type": "boolean", "const": true }, "stash_cleanup_state": { "type": "string", "enum": ["pending", "dropped"] } },
      "allOf": [
        { "if": { "properties": { "status": { "const": "merged" } }, "required": ["status"] }, "then": { "required": ["execution_head", "main_worktree", "merged_commit", "merged_at"], "properties": { "execution_head": true, "main_worktree": true, "merged_commit": true, "merged_at": true } } },
        { "if": { "properties": { "status": { "const": "done" } }, "required": ["status"] }, "then": { "required": ["execution_head", "main_worktree", "merged_commit", "merged_at", "cleaned_up_at"], "properties": { "execution_head": true, "main_worktree": true, "merged_commit": true, "merged_at": true, "cleaned_up_at": true } } }
      ]
    },
    "history": { "type": "array", "items": { "type": "object", "required": ["event", "detail", "at"], "additionalProperties": false, "properties": { "event": { "type": "string", "minLength": 1 }, "detail": { "type": "string", "minLength": 1 }, "at": { "$ref": "#/$defs/shanghai-date-time" } } } }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "executing" } }, "required": ["status"] }, "then": { "properties": { "review": { "type": "object", "properties": { "status": { "const": "pending" } }, "required": ["status"] }, "integration": { "type": "object", "properties": { "status": { "const": "pending" } }, "required": ["status"] } } } },
    { "if": { "properties": { "status": { "const": "reviewing" } }, "required": ["status"] }, "then": { "properties": { "review": { "type": "object", "properties": { "status": { "enum": ["in_progress", "awaiting_user"] } }, "required": ["status"] }, "integration": { "type": "object", "properties": { "status": { "const": "pending" } }, "required": ["status"] } }, "not": { "properties": { "tickets": { "type": "array", "contains": { "type": "object", "properties": { "status": { "not": { "const": "done" } } }, "required": ["status"] } } } } } },
    { "if": { "properties": { "status": { "const": "fixing" } }, "required": ["status"] }, "then": { "properties": { "review": { "type": "object", "properties": { "status": { "const": "done" }, "decision": { "const": "fix" } }, "required": ["status", "decision"] }, "integration": { "type": "object", "properties": { "status": { "const": "pending" } }, "required": ["status"] } }, "not": { "properties": { "tickets": { "type": "array", "contains": { "type": "object", "properties": { "status": { "not": { "const": "done" } } }, "required": ["status"] } } } } } },
    { "if": { "properties": { "status": { "const": "integrating" } }, "required": ["status"] }, "then": { "properties": { "review": { "type": "object", "properties": { "status": { "const": "done" } }, "required": ["status"] } }, "not": { "properties": { "tickets": { "type": "array", "contains": { "type": "object", "properties": { "status": { "not": { "const": "done" } } }, "required": ["status"] } } } } } },
    { "if": { "properties": { "status": { "const": "complete" } }, "required": ["status"] }, "then": { "properties": { "integration": { "type": "object", "properties": { "status": { "const": "done" } }, "required": ["status"] }, "review": { "type": "object", "properties": { "status": { "const": "done" } }, "required": ["status"] } }, "not": { "properties": { "tickets": { "type": "array", "contains": { "type": "object", "properties": { "status": { "not": { "const": "done" } } }, "required": ["status"] } } } } } },
    { "if": { "properties": { "status": { "enum": ["integrating", "complete"] }, "review": { "type": "object", "properties": { "decision": { "const": "fix" } }, "required": ["decision"] } }, "required": ["status", "review"] }, "then": { "properties": { "review": { "type": "object", "required": ["fix_commit", "fix_checks"], "properties": { "fix_commit": true, "fix_checks": true } } } } }
  ]
}
