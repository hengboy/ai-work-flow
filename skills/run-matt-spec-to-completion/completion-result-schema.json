{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengboy/ai-work-flow/schemas/run-matt-spec-to-completion/completion-result.schema.json",
  "title": "run-matt-spec-to-completion Completion Result",
  "description": "Completion Adapter 返回给编排器的单个 Ticket 终态结果。",
  "type": "object",
  "required": ["ticket_id", "status", "commits", "checks", "summary", "changed_paths"],
  "additionalProperties": false,
  "properties": {
    "ticket_id": {
      "type": "string",
      "minLength": 1,
      "description": "此终态结果所属的 Ticket ID。"
    },
    "status": {
      "type": "string",
      "enum": ["done", "blocked"]
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "已运行检查的记录。"
    },
    "changed_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/path-change" }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "error": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "path-change": {
      "type": "object",
      "required": ["record_type", "index_status", "worktree_status", "path"],
      "additionalProperties": false,
      "properties": {
        "record_type": { "enum": ["1", "2", "u", "?", "!"] },
        "index_status": { "enum": [".", "M", "T", "A", "D", "R", "C", "U"] },
        "worktree_status": { "enum": [".", "M", "T", "A", "D", "R", "C", "U"] },
        "path": { "type": "string", "minLength": 1, "not": { "pattern": "\\u0000" } },
        "source_path": { "type": "string", "minLength": 1, "not": { "pattern": "\\u0000" } }
      },
      "allOf": [
        { "if": { "properties": { "record_type": { "const": "2" } }, "required": ["record_type"] }, "then": { "required": ["source_path"], "properties": { "source_path": true } } },
        { "if": { "properties": { "record_type": { "not": { "const": "2" } } }, "required": ["record_type"] }, "then": { "not": { "required": ["source_path"] } } }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "done" } }, "required": ["status"] },
      "then": {
        "properties": {
          "commits": { "type": "array", "minItems": 1 }
        },
        "not": {
          "required": ["error"],
          "properties": {
            "error": true
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
      "then": {
        "required": ["error"],
        "properties": {
          "commits": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ]
}
