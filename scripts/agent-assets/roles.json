{
  "version": 1,
  "roles": [
    {
      "id": "coding",
      "name": "Coding",
      "description": "负责路由工作、等待受委派结果并汇总结论。",
      "kind": "primary",
      "default_primary": true,
      "policy": "coding",
      "delegates": [
        "file-explorer",
        "researcher",
        "document-maintainer",
        "planning-writer",
        "full-stack-coder",
        "git-committer",
        "code-reviewer"
      ],
      "tools": [],
      "routing_sections": ["browser-governance", "retry-governance", "implementation-governance"]
    },
    {
      "id": "planning",
      "name": "Planning",
      "description": "通过持续问询建立共享理解，并生成可直接实施的完整计划。",
      "kind": "primary",
      "policy": "planning",
      "delegates": ["file-explorer", "planning-writer", "task-planner", "git-committer"],
      "tools": ["Task"],
      "routing_sections": ["browser-governance", "retry-governance"]
    },
    {
      "id": "file-explorer",
      "name": "File Explorer",
      "description": "负责全仓库枚举、搜索和代码地图。",
      "kind": "subagent",
      "policy": "discover",
      "delegates": [],
      "tools": ["Read", "Glob", "Grep", "Bash"],
      "routing_sections": ["browser-governance"]
    },
    {
      "id": "researcher",
      "name": "Researcher",
      "description": "负责研究外部官方资料并报告带引用的发现。",
      "kind": "subagent",
      "policy": "research",
      "delegates": [],
      "tools": ["WebSearch", "WebFetch"],
      "routing_sections": ["browser-governance"]
    },
    {
      "id": "document-maintainer",
      "name": "Document Maintainer",
      "description": "负责维护项目普通文档。",
      "kind": "subagent",
      "policy": "write-docs",
      "delegates": [],
      "tools": ["Read", "Edit", "Write", "Bash"],
      "routing_sections": ["browser-governance", "handoff-governance"]
    },
    {
      "id": "planning-writer",
      "name": "Planning Writer",
      "description": "负责编写计划、ADR、交接和跟踪器文本。",
      "kind": "subagent",
      "policy": "write-plans",
      "delegates": [],
      "tools": ["Read", "Edit", "Write", "Bash"],
      "routing_sections": ["browser-governance", "handoff-governance"]
    },
    {
      "id": "task-planner",
      "name": "Task Planner",
      "description": "负责把已确认计划拆分为可跟踪的实施任务。",
      "kind": "subagent",
      "policy": "write-tasks",
      "delegates": [],
      "tools": ["Read", "Edit", "Write", "Bash"],
      "routing_sections": ["browser-governance", "handoff-governance"]
    },
    {
      "id": "full-stack-coder",
      "name": "Full Stack Coder",
      "description": "负责实现源码、测试、必要配置和修复。",
      "kind": "subagent",
      "policy": "write-code",
      "delegates": ["file-explorer"],
      "tools": ["Read", "Edit", "Write", "Bash", "Task"],
      "routing_sections": ["browser-governance", "retry-governance", "implementation-governance"]
    },
    {
      "id": "git-committer",
      "name": "Git Committer",
      "description": "负责受控 Git 提交。",
      "kind": "subagent",
      "policy": "commit",
      "delegates": [],
      "tools": ["Read", "Bash"],
      "routing_sections": ["browser-governance", "implementation-governance"]
    },
    {
      "id": "code-reviewer",
      "name": "Code Reviewer",
      "description": "仅由 Coding 调用的双轴审查编排角色，负责在差异稳定后调度标准审查和规范审查。",
      "kind": "subagent",
      "policy": "review",
      "delegates": ["review-standards", "review-spec"],
      "tools": ["Read", "Glob", "Grep", "Bash", "Task"],
      "routing_sections": ["browser-governance", "retry-governance", "review-governance"]
    },
    {
      "id": "review-standards",
      "name": "Review Standards",
      "description": "仅由 Code Reviewer 调用的终端角色，负责依据仓库标准审查稳定差异。",
      "kind": "reviewer",
      "policy": "review",
      "delegates": [],
      "tools": ["Read", "Glob", "Grep", "Bash"],
      "routing_sections": ["browser-governance", "review-governance"]
    },
    {
      "id": "review-spec",
      "name": "Review Spec",
      "description": "仅由 Code Reviewer 调用的终端角色，负责依据已批准的规范审查稳定差异。",
      "kind": "reviewer",
      "policy": "review",
      "delegates": [],
      "tools": ["Read", "Glob", "Grep", "Bash"],
      "routing_sections": ["browser-governance", "review-governance"]
    }
  ]
}
