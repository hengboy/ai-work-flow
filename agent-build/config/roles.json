{
  "roles": [
    {
      "id": "coding",
      "name": "Coding",
      "description": "分诊直接请求，并在当前会话持续调度实施、提交、审查、修复与整合。",
      "kind": "primary",
      "default_primary": true,
      "policy": "coding",
      "controls": ["no-direct-workspace-operations", "coding-orchestration-only"],
      "delegates": ["file-explorer", "researcher", "document-maintainer", "planning-writer", "full-stack-coder", "bug-fixer", "git-operator", "environment-operator", "code-reviewer"],
      "tools": ["Task"],
      "actions": ["coding.triage"]
    },
    {
      "id": "planning",
      "name": "Planning",
      "description": "查清事实和实质性产品决定，自动完成规划流程但不实施。",
      "kind": "primary",
      "policy": "planning",
      "controls": ["no-direct-workspace-operations", "planning-no-implementation"],
      "delegates": ["file-explorer", "researcher", "planning-writer", "task-planner", "git-operator"],
      "tools": ["Task"],
      "actions": ["planning.confirm", "planning.select_task_mode", "planning.confirm_task_preview", "planning.complete"]
    },
    {
      "id": "file-explorer",
      "name": "File Explorer",
      "description": "索引优先执行只读发现，并核验写后的规划工件。",
      "kind": "subagent",
      "policy": "discover",
      "controls": ["read-only-discovery"],
      "delegates": [],
      "tools": ["Read", "Glob", "Grep", "Bash", "Skill"],
      "actions": ["planning.discover", "planning.verify_tasks"]
    },
    {
      "id": "researcher",
      "name": "Researcher",
      "description": "使用官方来源研究并完成一份带引用报告。",
      "kind": "subagent",
      "policy": "research",
      "controls": ["official-research-only", "research-report-path-only", "single-research-report-only"],
      "delegates": [],
      "tools": ["Read", "WebSearch", "WebFetch", "Write"],
      "actions": []
    },
    {
      "id": "document-maintainer",
      "name": "Document Maintainer",
      "description": "精确维护指定普通文档并验证事实。",
      "kind": "subagent",
      "policy": "write-docs",
      "controls": ["ordinary-docs-only", "no-git-mutation"],
      "delegates": [],
      "tools": ["Read", "Edit", "Write", "Bash"],
      "actions": []
    },
    {
      "id": "planning-writer",
      "name": "Planning Writer",
      "description": "分别写入并验证指定 spec 或 plan。",
      "kind": "subagent",
      "policy": "write-plans",
      "controls": ["single-planning-artifact-only", "no-git-mutation"],
      "delegates": [],
      "tools": ["Read", "Edit", "Write", "Bash"],
      "actions": ["planning.write_spec", "planning.write_plan"]
    },
    {
      "id": "task-planner",
      "name": "Task Planner",
      "description": "预览、修订并在用户确认后写入完整 task 集合。",
      "kind": "subagent",
      "policy": "write-tasks",
      "controls": ["task-artifacts-only"],
      "delegates": [],
      "tools": ["Read", "Edit", "Write", "Bash"],
      "actions": ["planning.preview_tasks", "planning.revise_task_preview", "planning.write_tasks"]
    },
    {
      "id": "full-stack-coder",
      "name": "Full Stack Coder",
      "description": "在指定 worktree 完成最小实现、验证和导航维护。",
      "kind": "subagent",
      "policy": "write-code",
      "controls": ["implementation-worktree-only", "planning-artifacts-immutable", "no-git-mutation"],
      "delegates": ["file-explorer"],
      "tools": ["Read", "Edit", "Write", "Bash", "Skill", "Task"],
      "actions": ["coding.implement", "coding.implement_task", "coding.validate_plan", "coding.validate_plan_resync_1", "coding.validate_plan_resync_2"]
    },
    {
      "id": "bug-fixer",
      "name": "Bug Fixer",
      "description": "修复可复现 bug 或当前审查轮的 blocking finding。",
      "kind": "subagent",
      "policy": "write-code",
      "controls": ["implementation-worktree-only", "planning-artifacts-immutable", "authorized-bug-or-finding-only", "no-git-mutation"],
      "delegates": ["file-explorer", "researcher", "document-maintainer"],
      "tools": ["Read", "Edit", "Write", "Bash", "Task"],
      "actions": ["coding.fix_direct", "coding.fix_1", "coding.fix_2"]
    },
    {
      "id": "git-operator",
      "name": "Git Operator",
      "description": "执行唯一 Git mutation、Git 事实验证和安全清理。",
      "kind": "subagent",
      "policy": "commit",
      "controls": ["safe-local-git-only"],
      "delegates": [],
      "tools": ["Read", "Bash", "Skill"],
      "actions": ["planning.commit", "coding.prepare", "coding.prepare_direct_bug", "coding.prepare_task", "coding.commit_task", "coding.integrate_task", "coding.cleanup_task", "coding.commit", "coding.commit_fix_1", "coding.commit_fix_2", "coding.prepare_review", "coding.prepare_rereview_1", "coding.prepare_rereview_2", "coding.integrate", "coding.resync_1", "coding.prepare_resync_review_1", "coding.integrate_1", "coding.resync_2", "coding.prepare_resync_review_2", "coding.integrate_2", "coding.cleanup"]
    },
    {
      "id": "environment-operator",
      "name": "Environment Operator",
      "description": "校验并生成受管理 Agent 环境，或事务式切换既有环境。",
      "kind": "subagent",
      "policy": "environment",
      "controls": ["managed-environment-only", "no-git-mutation"],
      "delegates": [],
      "tools": ["Bash", "Skill"],
      "actions": []
    },
    {
      "id": "code-reviewer",
      "name": "Code Reviewer",
      "description": "验证完整 ReviewPacket，编排并聚合完整双轴审查。",
      "kind": "subagent",
      "policy": "review",
      "controls": ["review-read-only", "fixed-review-range-only", "review-orchestration-only"],
      "delegates": ["review-standards", "review-spec"],
      "tools": ["Read", "Glob", "Grep", "Bash", "Task"],
      "actions": ["coding.review", "coding.rereview_1", "coding.rereview_2", "coding.resync_review_1", "coding.resync_review_2"]
    },
    {
      "id": "review-standards",
      "name": "Review Standards",
      "description": "依据冻结标准和 committed review slices 审查。",
      "kind": "reviewer",
      "policy": "review",
      "controls": ["review-read-only", "fixed-review-range-only", "review-leaf-no-delegation"],
      "delegates": [],
      "tools": ["Read", "Glob", "Grep", "Bash"],
      "actions": []
    },
    {
      "id": "review-spec",
      "name": "Review Spec",
      "description": "依据冻结规格、验收证据和 committed review slices 审查。",
      "kind": "reviewer",
      "policy": "review",
      "controls": ["review-read-only", "fixed-review-range-only", "review-leaf-no-delegation"],
      "delegates": [],
      "tools": ["Read", "Glob", "Grep", "Bash"],
      "actions": []
    }
  ]
}
